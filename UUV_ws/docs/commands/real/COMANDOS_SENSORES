COMO SOLICITAR CONDICIONES DE TRABAJO INICIALES    -   mar de agua promedio 35.0 ppt

python3 - <<'PY'
import serial
import time

puerto = "/dev/ttyUSB0"
comando = b"#15C1CF\r\n"

try:
    with serial.Serial(
        port=puerto,
        baudrate=115200,
        bytesize=serial.EIGHTBITS,
        parity=serial.PARITY_NONE,
        stopbits=serial.STOPBITS_TWO,
        timeout=0.2,
        xonxoff=False,
        rtscts=False,
        dsrdtr=False,
    ) as ser:

        ser.reset_input_buffer()
        ser.reset_output_buffer()

        print(f"Puerto abierto: {puerto}")
        print(f"Enviando consulta de configuración: {comando!r}")

        ser.write(comando)
        ser.flush()

        limite = time.monotonic() + 3.0
        respuesta = bytearray()

        while time.monotonic() < limite:
            datos = ser.read(512)

            if datos:
                respuesta.extend(datos)

                if b"\r\n" in respuesta:
                    break

        if respuesta:
            texto = respuesta.decode("ascii", errors="replace")
            print("Respuesta:")
            print(texto)
            print("HEX ASCII:", respuesta.hex(" "))
        else:
            print("No se recibió respuesta.")

except serial.SerialException as error:
    print("Error serial:", error)
PY



