URL=$(python3 - <<'PY'
import json, urllib.request
tag = "v2.3.4"
api = f"https://api.github.com/repos/bluerobotics/ping-viewer/releases/tags/{tag}"
data = json.load(urllib.request.urlopen(api))
assets = data["assets"]
candidates = [
    a for a in assets
    if "appimage" in a["name"].lower()
    and not any(x in a["name"].lower() for x in ["arm", "aarch", "i386", "i686"])
]
if not candidates:
    raise SystemExit("No encontré AppImage compatible")
print(candidates[0]["browser_download_url"])
PY
)

